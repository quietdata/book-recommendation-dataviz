	column Decade = ```
			
			VAR Annee = IFERROR(VALUE(Books[Year-Of-Publication]), -1)
			RETURN
			IF(
			    Annee >= 1900 && Annee <= 2005,
			    INT(Annee / 10) * 10 & "s",
			    "Autre / Inconnu"
			)
			
			```
		lineageTag: a4593f26-d386-4515-a4c0-4086ac4e7e6e
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

