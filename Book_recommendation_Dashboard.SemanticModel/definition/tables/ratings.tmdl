	column Rating_Quality = ```
			
			SWITCH(
			    TRUE(),
			    Ratings[Book-Rating] = 0, "Implicite (0)",
			    Ratings[Book-Rating] >= 8, "Excellente (8-10)",
			    "Moyenne / Faible (1-7)"
			)
			
			```
		lineageTag: ba100b99-0860-4193-a0e0-3dc2650c2eed
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

