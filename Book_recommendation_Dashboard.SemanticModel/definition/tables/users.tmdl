	column Location_Valide
		dataType: boolean
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: e7c1cb84-ee5d-45d3-8cc8-9c350f457f74
		summarizeBy: none
		sourceColumn: Location_Valide

		annotation SummarizationSetBy = Automatic

	column Country_final
		dataType: string
		lineageTag: f2fc4980-c343-44dc-b25b-fe348e993813
		dataCategory: Country
		summarizeBy: none
		sourceColumn: Country_final

		annotation SummarizationSetBy = Automatic

	column Age_group = ```
			
			VAR AgeNum = IFERROR(VALUE(Users[Age]), -1)
			RETURN
			SWITCH(
			    TRUE(),
			    AgeNum < 5 || AgeNum > 100, "Non renseigné",
			    AgeNum < 18, "1. < 18 ans",
			    AgeNum <= 25, "2. 18-25 ans",
			    AgeNum <= 35, "3. 26-35 ans",
			    AgeNum <= 50, "4. 36-50 ans",
			    "5. 50+ ans"
			)
			
			```
		lineageTag: 68341634-9375-4794-ab60-04f66c8254a4
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Statut_Lecteur =
			
			IF(
			    COUNTROWS(RELATEDTABLE(Ratings)) > 0,
			    "Lecteur actif (1+ note)",
			    "Inscrit sans activité"
			)
		lineageTag: adb3f3ee-ea61-43d3-b512-04a2efb804e2
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition users = m
		mode: import
		source =
				let
				  Source = MySQL.Database("localhost", "book_reco_db"),
				  #"Navigation 1" = Source{[Schema = "book_reco_db", Item = "users"]}[Data],
				  #"Colonne personnalisée ajoutée" = Table.AddColumn(#"Navigation 1", "Country_final", each Text.Trim(Text.Select(Text.Upper([Country]), {"A".."Z", " "}))),
				  #"Type de colonne changé" = Table.TransformColumnTypes(#"Colonne personnalisée ajoutée", {{"Country_final", type text}})
				in
				  #"Type de colonne changé"

	annotation PBI_ResultType = Table

